EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/orders/payment/vnpay/return/

# Chatbot AI - lay API key mien phi tai https://aistudio.google.com/apikey
CHATBOT_ENABLED=true
CHATBOT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
CHATBOT_RATE_LIMIT_PER_HOUR=20
CHATBOT_MAX_TOOL_ROUNDS=3
CHATBOT_HISTORY_LIMIT=10
CHATBOT_TIMEOUT_SECONDS=20
CHATBOT_MAX_MESSAGE_LENGTH=1000
CHATBOT_MAX_SEARCH_LIMIT=8
CHATBOT_MAX_CLARIFY_TURNS=2
